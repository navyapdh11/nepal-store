// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Int
  category    String
  image       String
  sizes       String   // JSON array stored as string
  colors      String   // JSON array stored as string
  isNew       Boolean  @default(false)
  rating      String   @default("4.5")
  reviews     Int      @default(0)
  season      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model SanitizationLog {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  sector                String
  location              String
  technicianId          String
  status                String   @default("COMPLETED")
  throughputMetrics     String   // High-throughput 2026 data
}

model AuditTrail {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  action    String
  userId    String
  details   String
}

model PricingMatrix {
  id        String   @id @default(cuid())
  tier      String
  sector    String
  price     Float
}
