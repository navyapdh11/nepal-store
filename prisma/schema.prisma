// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model SanitizationLog {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  sector                String
  location              String
  technicianId          String
  status                String   @default("COMPLETED")
  throughputMetrics     String   // High-throughput 2026 data
}

model AuditTrail {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  action    String
  userId    String
  details   String
}

model PricingMatrix {
  id        String   @id @default(cuid())
  tier      String
  sector    String
  price     Float
}
